# EJEMPLO. NO CONTIENE CREDENCIALES. Archivo real: /etc/crt-vmr-5g.env
VMR_AUTH_USER=CREAR_USUARIO_REAL
VMR_PASSWORD_HASH=GENERAR_USANDO_create_login.py
VMR_SESSION_HOURS=8
VMR_COOKIE_SECURE=1
VMR_PUBLIC_ORIGIN=https://DOMINIO-INSTITUCIONAL:8084
VMR_ENABLE_HSTS=1
VMR_USERS_DB=/var/lib/crt-vmr-5g/users.sqlite3
VMR_TRUST_PROXY=0
# VMR_REGISTRATION_CODE_HASH=CONFIGURAR_SOLO_SI_USA_INVITACIONES
