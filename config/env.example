# Referencia sin secretos. NO copiar hashes ni contraseñas al repositorio.
VMR_AUTH_USER=COLOQUE_USUARIO_REAL
VMR_PASSWORD_HASH=GENERAR_CON_create_login.py
VMR_COOKIE_SECURE=1
VMR_SESSION_HOURS=8
VMR_PUBLIC_ORIGIN=https://DOMINIO_OFICIAL:8084
VMR_ENABLE_HSTS=1
VMR_USERS_DB=/var/lib/crt-vmr-5g/users.sqlite3
VMR_TRUST_PROXY=0
