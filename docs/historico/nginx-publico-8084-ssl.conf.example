# OPCIÓN B: el Nginx será visible por HTTPS en 8084,
# y Python estará SOLO en 127.0.0.1:18084.
# No incluya esto si otra aplicación ya usa el puerto o el mismo bloque Nginx.
server {
    listen 8084 ssl;
    server_name calculadora.su-dominio.gob.mx;
    ssl_certificate /etc/ssl/certs/calculadora.crt;
    ssl_certificate_key /etc/ssl/private/calculadora.key;
    client_max_body_size 8k;
    location / {
        proxy_pass http://127.0.0.1:18084;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
